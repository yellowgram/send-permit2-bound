{
  "name": "send-permit2-bound",
  "version": "0.2.0",
  "description": "Deprecated: merged into l2-send-guard 1.x. This package still works but gets no fixes. See https://github.com/yellowgram/l2-safety-proxy#migrating",
  "type": "module",
  "main": "./dist/api.js",
  "types": "./dist/api.d.ts",
  "bin": {
    "send-permit2-bound": "./dist/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/api.d.ts",
      "import": "./dist/api.js"
    }
  },
  "files": [
    "dist",
    "policy.example.json",
    "policy.agent.example.json",
    "docs/fixtures/offline.expected.txt",
    "SECURITY.md",
    "CHANGELOG.md",
    "LICENSE",
    "README.md",
    "docs/DEMO.md"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit",
    "demo:offline": "npm run build && node scripts/demo-offline.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "ethereum",
    "permit2",
    "middleware",
    "agent",
    "fail-closed",
    "deprecated"
  ],
  "license": "MIT",
  "author": {
    "name": "yellowgram",
    "url": "https://www.yellowgram.dev"
  },
  "dependencies": {
    "viem": "^2.21.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yellowgram/send-permit2-bound.git"
  },
  "bugs": {
    "url": "https://github.com/yellowgram/send-permit2-bound/issues"
  },
  "homepage": "https://www.yellowgram.dev/oss"
}
